# URL sub-domain undangan (ganti dengan domain asli kamu)
# Contoh production:
# VITE_PRIA_URL=https://pria.namadomain.com
# VITE_WANITA_URL=https://wanita.namadomain.com
#
# Untuk development lokal:
# VITE_PRIA_URL=http://localhost:5173
# VITE_WANITA_URL=http://localhost:5176
VITE_PRIA_URL=https://pria.namadomain.com
VITE_WANITA_URL=https://wanita.namadomain.com

# Firebase (SAMA dengan undangan pria/wanita & admin) — untuk menampilkan
# nama resmi tamu di badge "Kepada Yth" (penting bila nama tamu pernah diganti).
# Tanpa ini portal tetap jalan, nama diambil dari ?to= / slug.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=